{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "7.1.3"
  },
  "constants": {
    "WP_HTTP_BLOCK_EXTERNAL": true
  },
  "steps": [
    {
      "step": "runPHP",
      "code": "<?php function nil_fixture_copy($f,$t){if(is_dir($f)){if(!is_dir($t))mkdir($t,0777,true);foreach(scandir($f) as $n)if($n!=='.'&&$n!=='..')nil_fixture_copy($f.'/'.$n,$t.'/'.$n);}else copy($f,$t);}nil_fixture_copy('/nil-source','/wordpress/wp-content/plugins/nilwears-bulk-manager'); rename('/wordpress/wp-content/plugins/nilwears-bulk-manager/nil-manager.php','/wordpress/wp-content/plugins/nilwears-bulk-manager/nilwears-bulk-manager.php');"
    },
    {
      "step": "runPHP",
      "code": "<?php define('WP_ADMIN',true);require '/wordpress/wp-load.php';try{require '/nil-tests/updater-icons.php';}catch(Throwable $e){file_put_contents('/nil-tests/icons-result.txt','FAIL: '.$e->getMessage().' '.$e->getTraceAsString());throw $e;}"
    }
  ]
}
